<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme: dark window so there is never a white flash while Compose starts. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/mind_background</item>
        <item name="android:colorBackground">@color/mind_background</item>
        <item name="android:statusBarColor">@color/mind_background</item>
        <item name="android:navigationBarColor">@color/mind_background</item>
    </style>

    <!-- Launch theme (system splash screen on Android 12+). -->
    <style name="Theme.MyApplication.Starting" parent="Theme.MyApplication" />
</resources>
